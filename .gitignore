# techtrip-photography is a skills plugin. No photographs live here: tests build synthetic
# images under a temp directory, and users point the skills at folders of their own.

# System
.DS_Store
._*
Thumbs.db

# IDE / editors
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Claude Code local state (per-user, never shared)
.claude/settings.local.json
.claude/*.local.json

# skill-creator eval runs (evals.json is tracked; run output is not)
skills/*/evals/runs/
skills/*/evals/*.log

# Scratch output
*.log
*.tmp

# Hand-off bundles are built from the manifest and shipped out of band, never committed

# Local secrets / env
.env
.env.*

# Private keys and credentials (defense-in-depth; never commit these)
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
credentials*
secrets.y*ml
auth.json

# Incubator scratch output
incubator/**/runs/
